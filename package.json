{
  "name": "taskhub",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/",
    "desktop:build": "vite build --base ./",
    "desktop:mac": "npm run desktop:build && electron-builder --mac dmg --arm64 --publish never",
    "desktop:win": "npm run desktop:build && electron-builder --win nsis --x64 --publish never",
    "bump": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  },
  "build": {
    "appId": "com.taskhub.desktop",
    "productName": "TaskHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "icon": "mobile/assets/icon.png",
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    }
  }
}
