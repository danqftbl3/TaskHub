# Expo environment variables (used via expo-constants)
# Copy to .env and add to .gitignore

# Optional: Anthropic API key for live tutor (preferred for Socratic tutoring)
# Get from https://console.anthropic.com
EXPO_PUBLIC_AI_API_KEY=

# Optional: OpenAI API key for live tutor (fallback)
# Get from https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional: AI model to use (anthropic: claude-3-5-sonnet-20241022, openai: gpt-4o-mini)
EXPO_PUBLIC_AI_MODEL=claude-3-5-sonnet-20241022

# Optional: Base URL for API (if using a proxy or different provider)
EXPO_PUBLIC_AI_BASE_URL=https://api.anthropic.com/v1